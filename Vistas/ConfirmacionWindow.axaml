<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InventarioVideojuegos.Vistas.ConfirmacionWindow"
        Title="Confirmar eliminación"
        Width="380" Height="170"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="25">
        <TextBlock x:Name="TxtPregunta" TextWrapping="Wrap" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Sí, eliminar" Click="BtnSi_Click" />
            <Button Content="Cancelar" Click="BtnNo_Click" />
        </StackPanel>
    </StackPanel>

</Window>
