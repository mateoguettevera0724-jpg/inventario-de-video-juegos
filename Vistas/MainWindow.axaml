<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InventarioVideojuegos.Vistas.MainWindow"
        Title="Inventario de Videojuegos"
        Width="1150" Height="650"
        MinWidth="1000" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="330,*" Margin="15">

        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,15,0">
            <TextBlock Text="Datos del videojuego" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

            <TextBlock Text="Título" />
            <TextBox x:Name="TxtTitulo" MaxLength="100" />

            <TextBlock Text="Plataforma" />
            <ComboBox x:Name="CmbPlataforma" HorizontalAlignment="Stretch" PlaceholderText="Seleccione..." />

            <TextBlock Text="Género" />
            <ComboBox x:Name="CmbGenero" HorizontalAlignment="Stretch" PlaceholderText="Seleccione..." />

            <TextBlock Text="Formato" />
            <ComboBox x:Name="CmbFormato" HorizontalAlignment="Stretch" PlaceholderText="Seleccione..." />

            <TextBlock Text="Año de lanzamiento" />
            <TextBox x:Name="TxtAnio" MaxLength="4" />

            <TextBlock Text="Precio base (ej: 150000)" />
            <TextBox x:Name="TxtPrecio" />

            <TextBlock Text="Stock (unidades)" />
            <TextBox x:Name="TxtStock" MaxLength="6" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                <Button Grid.Row="0" Grid.Column="0" Content="Guardar nuevo" Click="BtnGuardar_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,8" />
                <Button Grid.Row="0" Grid.Column="1" Content="Actualizar" Click="BtnActualizar_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,8" />
                <Button Grid.Row="1" Grid.Column="0" Content="Eliminar" Click="BtnEliminar_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" />
                <Button Grid.Row="1" Grid.Column="1" Content="Limpiar" Click="BtnLimpiar_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" />
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBox x:Name="TxtBuscar" Width="340" Watermark="Buscar por título, plataforma, género o formato" />
                <Button Content="Buscar" Click="BtnBuscar_Click" />
                <Button Content="Ver todos" Click="BtnVerTodos_Click" />
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="GridJuegos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="GridJuegos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
                    <DataGridTextColumn Header="Plataforma" Binding="{Binding Plataforma}" Width="125" />
                    <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="100" />
                    <DataGridTextColumn Header="Formato" Binding="{Binding Formato}" Width="80" />
                    <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="60" />
                    <DataGridTextColumn Header="Precio base" Binding="{Binding PrecioBaseTexto}" Width="100" />
                    <DataGridTextColumn Header="Precio venta" Binding="{Binding PrecioVentaTexto}" Width="105" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" x:Name="TxtResumen" Margin="0,10,0,0" FontWeight="SemiBold" />

            <TextBlock Grid.Row="3" x:Name="TxtMensaje" Margin="0,8,0,0"
                       TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="22" />
        </Grid>

    </Grid>

</Window>
